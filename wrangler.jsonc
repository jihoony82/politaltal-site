{
  // 정치탈탈 배포 설정 — Cloudflare Workers + Static Assets
  // main(worker.js)은 /bills/* 만 처리하고, 나머지는 정적 자산으로 직행한다.
  // (이 파일이 있으면 wrangler가 자동생성 대신 이 설정을 사용)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "politaltal",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // 워커 코드 실행 위치 = 서울. 한국 접속은 대개 홍콩(HKG) 데이터센터로 들어오는데, 홍콩은 Anthropic API 미지원 지역이라
  // 의원실 AI 초안이 403 "Request not allowed"로 막혔다(10-29). 정적 자산은 그대로 가까운 곳에서 나간다.
  "placement": { "region": "aws:ap-northeast-2" },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /bills/*(동적 렌더링)·/push/*(앱 푸시 토큰)·/ledger/*(후원 장부·관리자 통계)·/wall/*(후원자의 벽)·/pc/*(정치인 한마디)·/pay/*(카드 후원)·/t(방문 집계)·/hot(실시간 많이 찾는 정치인)·/war/*(정치 전장 화력)·/ofc/*(의원실 센터)·/sm/*(신문고)·/news/*(좌우 뉴스)만 Worker를 먼저 실행. 그 외는 Worker를 거치지 않음.
    "run_worker_first": ["/bills/*", "/push/*", "/ledger/*", "/wall/*", "/pc/*", "/pay/*", "/news/*", "/war/*", "/ofc/*", "/sm/*", "/t", "/hot"]
  },
  // 앱 푸시 토큰 + 후원 장부(ledger 테이블) 저장소. database_id 를 비워 두면 배포 때 wrangler가 자동 생성·연결한다.
  // 좌우 뉴스 RSS 를 20분마다 모은다(worker.js scheduled → newsFetch)
  "triggers": { "crons": ["*/20 * * * *"] },
  "d1_databases": [{ "binding": "PUSH_DB", "database_name": "politaltal-push" }],
  // 의원실 소식 사진(worker.js /ofc/upload·/ofc/m/*). 버킷은 wrangler r2 bucket create 로 만들어 둠(10-29)
  "r2_buckets": [{ "binding": "OFC_MEDIA", "bucket_name": "politaltal-ofc-media" }]
}
